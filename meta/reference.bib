@ARTICLE{Barnes2002-kj,
  title     = "Biodiversity: invasions by marine life on plastic debris",
  author    = "Barnes, David K A",
  abstract  = "Colonization by alien species poses one of the greatest threats
               to global biodiversity. Here I investigate the colonization by
               marine organisms of drift debris deposited on the shores of 30
               remote islands from the Arctic to the Antarctic (across all
               oceans) and find that human litter more than doubles the rafting
